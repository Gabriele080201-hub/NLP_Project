# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.

# Required for live Gemini extraction. Without it the backend falls back
# to fixed mock data (same output for every input).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Gemini model used for extraction.
GEMINI_MODEL=gemini-2.5-flash

# OPTIONAL. Path to a masterdata folder containing "2. Masterdata/".
# Leave EMPTY to use the masterdata bundled in the repo (backend/data) — the
# default, so a fresh clone works out of the box. Set this only to point at a
# different/updated catalog; if the path is missing the backend automatically
# falls back to the bundled data.
DATA_DIR=
